  "storyboard": [
    {
      "id": "4af918ae-4eeb-4314-811a-06a272b84d0a",
      "name": "A stopped bird",
      "start": 0,
      "duration": 24,
      "text": "Discover the bird and its repair. Measured opening changes, not confirmed musical phrases."
    },
    {
      "id": "d29dbe92-8481-4994-8bcf-a56081fe6ddc",
      "name": "Finding a rhythm",
      "start": 24,
      "duration": 40,
      "text": "The workbench and receiver answer the music; a winding action leads toward the river."
    },
    {
      "id": "cd3adf39-a511-415e-9af0-9acbc34acd0e",
      "name": "The journey",
      "start": 64,
      "duration": 40,
      "text": "The watchmaker carries the bird to the water; moving waveforms and ripples reflect the mixed recording."
    },
    {
      "id": "873323c9-14aa-42bd-a4c5-57581c20fc61",
      "name": "A moment of release",
      "start": 104,
      "duration": 33,
      "text": "The bird rests in open hands. Measured level drops at 124–132; verify by listening."
    },
    {
      "id": "e41c38cf-9350-4bfb-9fda-065d406860a8",
      "name": "Flight",
      "start": 137,
      "duration": 21,
      "text": "The bird rises as the scene opens. The level rise is not proof of a climax."
    },
    {
      "id": "98ee4680-c251-4c0b-9a94-97bd01c0e6b7",
      "name": "What remains",
      "start": 158,
      "duration": 12,
      "text": "Morning returns to the empty workbench; hold through the whole ending."
    }
  ],
  "effects": [
    {
      "id": "47b4915e-3089-4ab7-9638-238f3660ce00",
      "name": "Motion and sound",
      "start": 0,
      "duration": 170,
      "text": "Stills carry applied camera movement. The 28, 52, 76, 104 and 132 second environmental clips are baked to Take A and must not move without regeneration. Live abstract editor presets follow song time."
